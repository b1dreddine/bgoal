# Copy to .env and fill in. Never commit .env or anything in secrets/.

# mock | football_data | api_football
PROVIDER=mock

# https://www.football-data.org/client/register  (free: 10 req/min)
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_COMPETITIONS=PL,PD,SA,BL1,FL1,DED,PPL,ELC,CL,EC,WC,BSA

# https://dashboard.api-football.com  (paid plan recommended for live polling)
API_FOOTBALL_API_KEY=
API_FOOTBALL_LEAGUES=39,140,135,78,61,2
API_FOOTBALL_SEASON=2026

# Keep under your plan's limit; the worker uses ~5/min with the defaults below.
PROVIDER_REQUESTS_PER_MINUTE=10
LIVE_POLL_SECONDS=15
FIXTURES_SYNC_SECONDS=600
DEVICE_RETENTION_DAYS=90

# Firebase service-account JSON (put the file in backend/secrets/). Empty = log pushes only.
FIREBASE_CREDENTIALS_FILE=
# FIREBASE_CREDENTIALS_FILE=/srv/secrets/firebase-service-account.json

# Only used when running outside docker-compose
DATABASE_URL=postgresql+asyncpg://livescores:livescores@localhost:5432/livescores
REDIS_URL=redis://localhost:6379/0
